rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'am05021986@gmail.com' ||
        request.auth.token.email == 'contact.elitedesignerjewelry@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Health / connectivity diagnostic endpoint
    match /test/{testId} {
      allow read: if isValidId(testId);
      allow write: if isAdmin();
    }

    // Jewelry product catalog
    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    // Customer orders
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidId(orderId) &&
        incoming().id == orderId &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().customerName.size() <= 120 &&
        incoming().phone is string &&
        incoming().phone.size() > 0 &&
        incoming().phone.size() <= 30 &&
        incoming().total is number &&
        incoming().total >= 0;
      allow update, delete: if isAdmin();
    }

    // Consultation bookings
    match /consultations/{consultationId} {
      allow read: if isAdmin();
      allow create: if isValidId(consultationId) &&
        incoming().id == consultationId &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().customerName.size() <= 120 &&
        incoming().customerPhone is string &&
        incoming().customerPhone.size() > 0 &&
        incoming().customerPhone.size() <= 30 &&
        incoming().mode in ['showroom', 'online'];
      allow update, delete: if isAdmin();
    }

    // Bespoke quotations
    match /quotations/{quotationId} {
      allow read: if isAdmin();
      allow create: if isValidId(quotationId) &&
        incoming().id == quotationId &&
        incoming().customerName is string &&
        incoming().customerName.size() > 0 &&
        incoming().customerName.size() <= 120 &&
        incoming().customerPhone is string &&
        incoming().customerPhone.size() > 0 &&
        incoming().customerPhone.size() <= 30 &&
        incoming().productName is string &&
        incoming().productName.size() > 0 &&
        incoming().productName.size() <= 200;
      allow update, delete: if isAdmin();
    }

    // Admin role access control
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
